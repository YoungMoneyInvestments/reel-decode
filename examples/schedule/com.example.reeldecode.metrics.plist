<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS launchd job: twice a day. Replace /path/to/my-content, copy to ~/Library/LaunchAgents/,
     then: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.example.reeldecode.metrics.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.reeldecode.metrics</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/my-content/metrics_cycle.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>REELDECODE_PROJECT</key><string>/path/to/my-content</string>
    <key>REELDECODE_BIN</key><string>/path/to/my-content/.venv/bin/reeldecode</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>15</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>15</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/path/to/my-content/metrics.log</string>
  <key>StandardErrorPath</key><string>/path/to/my-content/metrics.log</string>
</dict>
</plist>
